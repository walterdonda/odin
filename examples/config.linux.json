{
  "databases": [
    {
      "name": "nombre_clave_sistema",
      "type": "firebird",
      "connection": "localhost/3050:/var/lib/firebird/data/erp.fdb",
      "user": "SYSDBA",
      "password": "***",
      "role": null,
      "charset": "ISO8859_1",
      "gbak_path": null
    },
    {
      "name": "ventas_pg",
      "type": "postgresql",
      "host": "db.example.com",
      "port": 5432,
      "dbname": "ventas",
      "user": "odin_backup",
      "password": "***",
      "pg_dump_path": null,
      "pg_dump_timeout_sec": null
    }
  ],
  "compression": {
    "level": 7,
    "password": null
  },
  "servers": [
    {
      "name": "sitio-alterno-1",
      "host": "203.0.113.10",
      "port": 22,
      "username": "odin",
      "auth": { "method": "password", "password": "***" },
      "remote_path": "/backups/odin/"
    },
    {
      "name": "sitio-alterno-2",
      "host": "backup.example.com",
      "port": 2222,
      "username": "odin",
      "auth": { "method": "key", "private_key": "~/.ssh/id_rsa", "passphrase": null },
      "remote_path": "/srv/backups/odin/"
    }
  ],
  "notification": {
    "to": "control@example.com",
    "from": "odin-backups@example.com",
    "smtp": {
      "host": "smtp.example.com",
      "port": 587,
      "starttls": true,
      "ssl": false,
      "username": "odin-backups@example.com",
      "password": "***"
    }
  },
  "local": {
    "work_dir": "/var/backups/odin",
    "retention_days": 7,
    "gbak_timeout_sec": 7200,
    "pg_dump_timeout_sec": 7200
  },
  "scheduler": {
    "enabled": true,
    "timezone": "America/Argentina/Buenos_Aires",
    "jobs": [
      {
        "databases": ["nombre_clave_sistema", "ventas_pg"],
        "schedule": "0 2 * * *",
        "on_misfire": "run_once",
        "skip_if_running": true
      }
    ]
  }
}
